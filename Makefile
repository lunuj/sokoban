# 操作系统库
ifeq ($(OS),)
    UNAME_S := $(shell uname -s)
    ifeq ($(UNAME_S),Darwin)
        OS := Mac
    else ifeq ($(UNAME_S),Linux)
        OS := Linux
    else ifeq ($(UNAME_S),Windows_NT)
        OS := Windows
    else
        OS := Windows
    endif
else ifeq ($(OS),Windows_NT)
	OS := Windows
endif

VERSION_FILE = src/version_auto.c
# 获取Git信息
GIT_COMMIT    := $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
GIT_TAG       := $(shell git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0")
GIT_DIRTY     := $(shell git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
BUILD_NUMBER  := $(shell git rev-list --count HEAD 2>/dev/null || echo "0")

# Makefile 片段
VERSION_MAJOR 	:= $(shell echo $(GIT_TAG) | cut -d. -f1 | sed 's/v//')
VERSION_MINOR 	:= $(shell echo $(GIT_TAG) | cut -d. -f2)
VERSION_PATCH 	:= $(shell echo $(GIT_TAG) | cut -d. -f3 | cut -d- -f1)
PRERELEASE 		:= $(shell echo $(GIT_TAG) | grep -o '\-.*' | sed 's/^-//' || echo "")

# 核心策略：根据dirty状态决定BUILD_ID
ifeq ($(GIT_DIRTY), 0)
    # ====== 情况A：干净仓库（已提交） ======
    PRERELEASE	:= release
    # 使用 commit hash + build number（可重现、可追溯）
    BUILD		:= $(GIT_COMMIT)-$(BUILD_NUMBER)
else
    # ====== 情况B：脏仓库（有未提交改动） ======
    PRERELEASE	:= debug
    # 使用 debug + 时间戳 + 用户名（直观、不污染版本号）
    BUILD_TIME	:= $(shell date +%Y.%m.%d-%H:%M:%S)
    BUILD_USER	:= $(shell whoami)
    BUILD     	:= $(BUILD_USER)-$(BUILD_TIME)
endif

RED		:= \033[0;31m
CYAN  	:= \033[0;36m
BLUE  	:= \033[0;34m
GREEN 	:= \033[0;32m
YELLOW 	:= \033[1;33m
PURPLE	:= \033[0;35m
DIM		:= \033[2m
NC    	:= \033[0m

VERSION_STRING := $(VERSION_MAJOR).$(VERSION_MINOR).$(VERSION_PATCH) - $(PRERELEASE) + $(BUILD)

# 自动生成版本头文件
generate-version:
	@echo "/* Auto-generated by Makefile. DO NOT EDIT. */" > $(VERSION_FILE)
	@echo "#include \"version.h\""                           >> $(VERSION_FILE)
	@echo ""                                               >> $(VERSION_FILE)
	@echo "const char *const VERSION_BUILD      = \"$(BUILD)\";"        >> $(VERSION_FILE)
	@echo "const char *const VERSION_STRING     = \"$(VERSION_STRING)\";" >> $(VERSION_FILE)
	@echo "const char *const VERSION_GIT_TAG    = \"$(GIT_TAG)\";"        >> $(VERSION_FILE)
	@echo "const char *const VERSION_GIT_COMMIT = \"$(GIT_COMMIT)\";"     >> $(VERSION_FILE)
	@echo "const char *const VERSION_BUILD_TIME = \"$(BUILD_TIME)\";"     >> $(VERSION_FILE)
	@echo "const char *const version_str = \"$(VERSION_STRING)\";"     >> $(VERSION_FILE)
	@echo "const Version version = {$(VERSION_MAJOR), $(VERSION_MINOR), $(VERSION_PATCH), \"$(PRERELEASE)\", \"$(BUILD)\"};"     >> $(VERSION_FILE)

echo-version: generate-version
	@printf "$(CYAN)Generated version: %s (build %s)\n" "$(GIT_TAG)" "$(BUILD)"
	@printf "$(CYAN)╔══════════════════════════════════════════════════════════════╗$(NC)\n"
	@printf "$(CYAN)║$(NC) $(BLUE)%-7s$(NC): $(GREEN)%-52s$(NC)$(CYAN)║$(NC)\n" "version" "$(GIT_TAG)"
	@printf "$(CYAN)║$(NC) $(BLUE)%-7s$(NC): $(YELLOW)%-52s$(NC)$(CYAN)║$(NC)\n" "build" "$(BUILD)"
	@printf "$(CYAN)║$(NC) $(BLUE)%-7s$(NC): $(PURPLE)%-52s$(NC)$(CYAN)║$(NC)\n" "release" "$(PRERELEASE)"
	@printf "$(CYAN)╚══════════════════════════════════════════════════════════════╝$(NC)\n"


# 编译工具
CROSS_COMPILE  := 
CC              := $(CROSS_COMPILE)gcc
LD              := $(CROSS_COMPILE)ld
OBJCOPY         := $(CROSS_COMPILE)objcopy
NM              := $(CROSS_COMPILE)nm
BIN_SUFFIX      := .out

# 文件目录
SOURCE_DIR      := src
LIB_DIR         := lib
INCLUDE_DIR     := include
MAIN_DIR        := main
OUTPUT_DIR      := output
RES_DIR      	:= res
OUTPUT_DEP_DIR  := $(OUTPUT_DIR)/.dep
OUTPUT_OBJ_DIR  := $(OUTPUT_DIR)/.obj
MODULES_DIR     := modules

# 确保必要目录存在
$(shell mkdir -p $(SOURCE_DIR) $(LIB_DIR)/$(OS) $(INCLUDE_DIR) $(MAIN_DIR) $(OUTPUT_DEP_DIR) $(OUTPUT_OBJ_DIR) $(MODULES_DIR) $(RES_DIR)) 
	
# 源文件收集
SRCS            := $(shell find $(SOURCE_DIR) -type f -name "*.c")
OBJS            := $(patsubst %.c,$(OUTPUT_OBJ_DIR)/%.o,$(SRCS))
DEPS            := $(patsubst %.c,$(OUTPUT_DEP_DIR)/%.d,$(SRCS))

SRCS_NO_MAIN    := $(filter-out $(SOURCE_DIR)/main.c, $(SRCS))
OBJS_NO_MAIN    := $(patsubst %.c,$(OUTPUT_OBJ_DIR)/%.o,$(SRCS_NO_MAIN))
DEPS_NO_MAIN    := $(patsubst %.c,$(OUTPUT_DEP_DIR)/%.d,$(SRCS_NO_MAIN))

MAIN_SRCS       := $(shell find $(MAIN_DIR) -type f -name "*.c")
MAIN_OBJS       := $(patsubst %.c,$(OUTPUT_OBJ_DIR)/%.o,$(MAIN_SRCS))
MAIN_DEPS       := $(patsubst %.c,$(OUTPUT_DEP_DIR)/%.d,$(MAIN_SRCS))
MAIN_OUT        := $(patsubst $(MAIN_DIR)/%.c,$(OUTPUT_DIR)/%$(BIN_SUFFIX),$(MAIN_SRCS))

TARGET_NAME 	?= plug

-include $(DEPS)
-include $(DEPS_NO_MAIN)
-include $(MAIN_DEPS)

ifeq ($(OS), Mac)
	OS_LIBS := -framework Cocoa -framework AppKit -framework Foundation \
			  -framework CoreFoundation -framework IOKit -framework CoreVideo \
			  -framework OpenGL -framework QuartzCore
else ifeq ($(OS), Linux)
  	OS_LIBS := -ldl -lpthread -lm -lX11
else ifeq ($(OS), Windows)
	OS_LIBS := -lgdi32 -luser32 -lkernel32 -lshell32 -lopengl32 -lwinmm
else
  	$(error Unsupported OS: $(OS))
endif

# 子模块收集
MODULES_INC 	:= $(patsubst %,-I%,$(wildcard $(MODULES_DIR)/*/$(INCLUDE_DIR)))
MODULES_OBJ	 	:= $(patsubst %,-L%,$(wildcard $(MODULES_DIR)/*/$(OUTPUT_DIR)))
MODULES_PATH 	:= $(foreach d,$(wildcard $(MODULES_DIR)/*/$(OUTPUT_DIR)) $(wildcard $(MODULES_DIR)/*/$(OUTPUT_DIR)),-Wl,-rpath,$(d))
MODULES_FILE    := $(patsubst lib%,-l%,$(basename $(notdir $(filter %.so %.lib %.a, $(wildcard $(MODULES_DIR)/*/$(OUTPUT_DIR)/*)))))

# 库文件收集
LIB_FILES 		:= $(shell find $(LIB_DIR)/$(OS) -type f  -name "*.so" -o -name "*.lib" -o -name "*.dll" -o -name "*.a")
LIBS_DIR		:= $(patsubst %,-L%,$(wildcard $(LIB_DIR)/$(OS)/*/))
LIBS 			:= $(foreach f,$(notdir $(LIB_FILES)),-l$(basename $(patsubst lib%,%,$(f))))

# 编译标志
CFLAGS          := -Wall -Wextra -g -fpic -Wno-unused-variable -Wno-missing-braces
INCLUDE         := -I$(INCLUDE_DIR) -I$(SOURCE_DIR) $(MODULES_INC)
LIB             := -L$(LIB_DIR)/$(OS) $(LIBS_DIR) $(MODULES_OBJ) $(MODULES_FILE) -Wl,-rpath=$(LIB_DIR)/$(OS) $(MODULES_PATH)

# 创建目录的规则
define MAKE_DIR
    @mkdir -p $1
endef

# 编译命令
$(OUTPUT_OBJ_DIR)/%.o : %.c
	$(call MAKE_DIR,$(dir $@))
	$(call MAKE_DIR,$(OUTPUT_DEP_DIR)/$(dir $*))
	$(CC) $(CFLAGS) $(INCLUDE) -MMD -MP -MF $(OUTPUT_DEP_DIR)/$*.d -MT $@ -c $< -o $@

# 默认目标
all:  $(MAIN_OUT)

# 测试目标
$(OUTPUT_DIR)/%.out: $(OUTPUT_OBJ_DIR)/$(MAIN_DIR)/%.o $(OBJS_NO_MAIN) | $(LIB_FILES) $(OUTPUT_OBJ_DIR)/$(MAIN_DIR)/%.o
	$(call MAKE_DIR,$(dir $@))
	$(CC) $^ $(LIB) $(LIBS) $(OS_LIBS) $(MODULES_FILE) -o $@

# 打印目标
print-%:
	@echo $($*)

# 清理目标
clean:
	rm -rf $(OUTPUT_DIR)

.PHONY: all clean

# 静态库目标
static: $(OBJS_NO_MAIN) | $(LIB_FILES)
	ar rcs $(OUTPUT_DIR)/lib$(TARGET_NAME).a $^

# 动态库目标
dynamic: $(OBJS_NO_MAIN) | $(LIB_FILES)
	$(CC) $(CFLAGS) $(INCLUDE) -fPIC -shared -o $(OUTPUT_DIR)/lib$(TARGET_NAME).so $^ $(LIB) $(LIBS) $(OS_LIBS)
